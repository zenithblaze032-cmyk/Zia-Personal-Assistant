# JARVIS — Voice Assistant
# Copy to `.env` and uncomment lines you want to override.

# --- Wake word ---------------------------------------------------------------
# WAKE_WORD=jarvis
# VOSK_MODEL_DIR=             # default: .cache/vosk-model-small-en-us
# MIC_GAIN_FACTOR=4.0         # mic gain multiplier before recognition

# --- State machine -----------------------------------------------------------
# IDLE_TIMEOUT_S=30           # seconds AWAKE before auto-sleeping

# --- Workspace ---------------------------------------------------------------
# LEETCODE_URL=https://leetcode.com/problemset/
# YOUTUBE_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLu0W_9lII9agq5TrH9XLIKQvv0iaF2X3w
# VSCODE_OPEN_PATH=D:\Development
# CHROME_NEW_WINDOW_WAIT_S=25

# --- TTS (Edge TTS fallback only — Piper is the primary) ---------------------
# JARVIS_TTS_VOICE=en-GB-RyanNeural
# JARVIS_TTS_RATE=+5%
# JARVIS_TTS_PITCH=-10Hz

# --- Mic selection -----------------------------------------------------------
# JARVIS_INPUT_DEVICE=        # mic index or name substring
