# Zia — Voice Assistant
# Copy to `.env` and uncomment lines you want to override.

# --- Wake word ---------------------------------------------------------------
# WAKE_WORD=wake up
# Extra phrases that also trigger waking (comma-separated, matched as substrings)
# WAKE_WORD_ALIASES=zia,hey zia,hi zia,ok zia,jarvis,hey jarvis,hi jarvis,ok jarvis,jervis,jarves,arise,okiro,okiru,wake-up,wakeup,wake up zia,wake up jarvis
# VOSK_MODEL_DIR=             # default: .cache/vosk-model-small-en-us
# MIC_GAIN_FACTOR=4.0         # mic gain multiplier before recognition

# --- State machine -----------------------------------------------------------
# IDLE_TIMEOUT_S=90           # seconds AWAKE before auto-sleeping
# TRIGGER_COOLDOWN_S=5.0
# POST_WAKE_COOLDOWN_S=3.0
# CLAP_THRESHOLD=3000

# --- Workspace ---------------------------------------------------------------
# LEETCODE_URL=https://leetcode.com/problemset/all/
# YOUTUBE_PLAYLIST_URL=https://music.youtube.com
# VSCODE_OPEN_PATH=D:\Development
# VSCODE_OPEN_TERMINAL=True
# TILED_LAYOUT_ENABLED=True
# CHROME_NEW_WINDOW_WAIT_S=25

# --- TTS Settings ------------------------------------------------------------
# Zia_WAKE_PHRASE="Welcome back sir, how can I help you?"
# Zia_WELCOME_PHRASE="All systems online. Workspace ready, sir."
# Zia_WORKSPACE_LAUNCH_PHRASE="All systems are online.... ready to ship some code..."
# Zia_SLEEP_PHRASE="Going offline. I'll be here when you need me."
# Zia_EXIT_PHRASE="Shutting down. Goodbye, sir."
# Zia_WELCOME_ENABLED=False
# Zia_SPEAK_DELAY_S=1.0

# --- Zen Mode TTS Responses --------------------------------------------------
# Zia_ZEN_ON_PHRASE="Zen Mode initialized. Lightning speed engaged."
# Zia_ZEN_OFF_PHRASE="Falling back to normal mode, as our zen limits are reached."

# --- TTS (Edge TTS fallback only — Piper is the primary) ---------------------
# Zia_TTS_VOICE=en-GB-RyanNeural
# Zia_TTS_RATE=+5%
# Zia_TTS_PITCH=-10Hz

# --- Piper voice (primary offline TTS) ---------------------------------------
# Pick any voice below (or any voice from rhasspy/piper-voices — downloaded
# automatically on first use). Run `python core/piper_tts.py --list` to see them.
#
# Male:   en_GB-alan-medium (default, classic Zia butler)
#         en_US-ryan-high · en_GB-northern_english_male-medium
#         en_US-joe-medium · en_US-danny-low
# Female: en_GB-jenny_dioco-medium · en_GB-southern_english_female-low
#         en_US-amy-medium · en_US-lessac-high · en_US-kathleen-low
#
# Zia_PIPER_VOICE=en_GB-alan-medium

# --- Mic selection -----------------------------------------------------------
# Zia_INPUT_DEVICE=        # mic index or name substring

# --- Framework Integration Flags ---------------------------------------------
# USE_EFFGEN=True
# USE_AGENTNOVA=True
# USE_AGENTSDK_STT=False
# AGENTNOVA_CONFIRM_DANGEROUS=True
# AGENTNOVA_TIMEOUT_SEC=120
# EFFGEN_COMPRESS_PROMPTS=True

# --- Zen Mode Fast API Keys (for Cloud Inference Fallback Chain) -------------
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

